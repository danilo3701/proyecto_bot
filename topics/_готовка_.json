  "dialogs": [
    {
      "phase_id": 1,
      "phase_name": "🥥 ДЕЙСТВИЯ С ЕДОЙ 🔪",
      "blocks": [
        {
          "lines": [
            "Я хочу <b>МАРИНОВАТЬ МЯСО</b> сегодня.",
            "yo quiero [[<b>MARINAR LA CARNE</b>]] esta noche."
          ]
        },
        {
          "lines": [
            "Сейчас я <b>ТЕРЕТЬ СЫР</b> для ужина.",
            "ahora voy a [[<b>RALLAR EL QUESO</b>]] para la cena."
          ]
        },
        {
          "lines": [
            "я хочу <b>мариновать мясо</b> сегодня.",
            "[[yo quiero <b>marinar la carne</b> esta noche.]]"
          ]
        },
        {
          "lines": [
            "сейчас я <b>тереть сыр</b> для ужина.",
            "[[ahora voy a <b>rallar el queso</b> para la cena.]]"
          ]
        },
        {
          "lines": [
            "Мне нужно <b>ИЗМЕЛЬЧАТЬ ИНГРЕДИЕНТЫ</b> для соуса.",
            "necesito [[<b>TRITURAR LOS INGREDIENTES</b>]] para la salsa."
          ]
        },
        {
          "lines": [
            "Я собираюсь <b>РУБИТЬ ЛУК</b> сейчас.",
            "voy a [[<b>PICAR LA CEBOLLA</b>]] ahora."
          ]
        },
        {
          "lines": [
            "мне нужно <b>измельчать ингредиенты</b> для соуса.",
            "[[necesito <b>triturar los ingredientes</b> para la salsa.]]"
          ]
        },
        {
          "lines": [
            "я собираюсь <b>рубить лук</b> сейчас.",
            "[[voy a <b>picar la cebolla</b> ahora.]]"
          ]
        },
        {
          "lines": [
            "Давайте <b>ДАТЬ СМЕСИ НАСТОЯТЬСЯ</b> десять минут.",
            "vamos a [[<b>DEJAR REPOSAR LA MEZCLA</b>]] diez minutos."
          ]
        },
        {
          "lines": [
            "Мне нужно <b>ОТЦЕДИТЬ ПАСТУ</b> сейчас.",
            "tengo que [[<b>ESCURRIR LA PASTA</b>]] ahora."
          ]
        },
        {
          "lines": [
            "давайте <b>дать смеси настояться</b> десять минут.",
            "[[vamos a <b>dejar reposar la mezcla</b> diez minutos.]]"
          ]
        },
        {
          "lines": [
            "мне нужно <b>отцедить пасту</b> сейчас.",
            "[[tengo que <b>escurrir la pasta</b> ahora.]]"
          ]
        }
      ]
    },
    {
      "phase_id": 2,
      "phase_name": "🍷 ТЕХНИКИ ГОТОВКИ 🥘",
      "blocks": [
        {
          "lines": [
